# .env.example —— config for `make prod-up` (docker-compose.prod.yml).
# Copy to .env and fill in. Values intentionally blank (lint-env enforces
# KEY= only); the comments say what to put. Real deploys: fresh random
# secrets + a real https PUBLIC_URL (Caddy signs Let's Encrypt on demand
# once a domain points at the host). The key set here must match exactly the
# ${VARS} docker-compose.prod.yml reads (enforced by env-lint rule 3).

# Postgres superuser password (bundled db).
POSTGRES_PASSWORD=
# Session cookie signing key (random).
SESSION_KEY=
# At-rest encryption key for connector secrets/tokens. MUST be >= 32 chars
# (the backend refuses to boot otherwise). Rotate per instance.
INSTANCE_SECRET=
# true on a real https deploy; false for a plain-http localhost bring-up.
SECURE_COOKIE=
# Visitor-agent LLM provider. Leave blank to set it per-owner from admin/MCP
# after claiming; or anthropic-compatible provider name here.
INFERENCE_PROVIDER=
INFERENCE_ANTHROPIC_KEY=
# Full public URL recruiters land on (scheme + host [+ port]). Real deploy:
# https://you.example.com. Local bring-up: http://localhost.
PUBLIC_URL=
# Bundled minio (object storage) root creds.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
# Browser-facing base for presigned object URLs. Real deploy: your public
# https origin. Local: http://localhost.
STORAGE_PUBLIC_URL=
