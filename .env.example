# .env.example —— config for `make prod-up` (docker-compose.prod.yml).
# Copy to .env and fill in. Values intentionally blank (lint-env rule 1); the
# comments say what to put. The key set here must match exactly the env vars
# docker-compose.prod.yml reads (env-lint rule 3).
#
# TLS / domain is external (your platform / Cloudflare / reverse proxy fronts
# the app's published port). The owner's public URL + LLM provider are NOT env:
# set them at claim time + in admin/MCP after.

# Postgres superuser password (bundled db).
POSTGRES_PASSWORD=
# Session cookie signing key (random).
SESSION_KEY=
# At-rest encryption key for connector secrets/tokens. MUST be >= 32 chars
# (the backend refuses to boot otherwise). Rotate per instance.
INSTANCE_SECRET=
# true behind https; false only for a plain-http localhost bring-up.
SECURE_COOKIE=
# Bundled minio (object storage) root creds + bucket.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
# Browser-facing base for presigned object URLs (your public storage origin).
STORAGE_PUBLIC_URL=
# Cloudflare Turnstile captcha. BOTH must be set to turn it on; leave both blank
# and there is no captcha anywhere (the per-IP lockouts still guard on their own).
# Cloudflare publishes test keys that always pass / always fail — use those to try
# it before putting real ones in.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Meilisearch — the lexical index corpus search runs on. It ships IN this stack, so all
# three of these are normally blank and the bundled service is used.
#
# It has to ship: the alternative (Postgres full-text) cannot segment Chinese, so a query
# matches only when it is byte-for-byte a contiguous Chinese run as it appears in the text.
# English is unaffected, which is how a bilingual corpus hides the hole from one side.
#
# MEILI_MASTER_KEY — the bundled service's own key. It has no host port and is reachable
# only from inside the stack, so the built-in default is fine; set it if you would rather
# not run with a documented one.
# MEILI_URL / MEILI_KEY — set BOTH to run against a Meili outside the stack; the bundled
# service then becomes dead weight you can delete from the compose file.
MEILI_MASTER_KEY=
MEILI_URL=
MEILI_KEY=
# How much memory Redis may hold before it starts dropping its oldest keys. Redis
# keeps visitor sessions, rate-limit buckets and the one-day job pool — all of them
# regenerate, so dropping the oldest beats refusing new ones. Leave it alone on a
# normal box; raise it if you run a large instance, lower it on a small VPS. Unset
# means 256mb. Do not set it to 0: unbounded means the container grows until the
# host kills it, and then every session goes at once.
REDIS_MAXMEMORY=
# Internal hosts the outbound guard is allowed to dial. **Leave this empty.** Empty means
# "nothing internal", which is what a self-hosted instance wants: a connector or a BYOAI
# endpoint pointed at 127.0.0.1 or at your LAN is either a mistake or an attack. It exists
# so a verification run can name one host (a fault-injecting proxy) for the length of a
# drive, and put it back afterwards.
EGRESS_ALLOW_HOSTS=
# The same, for connectors specifically (a separate policy from the one above: that one covers
# everything this backend dials, this one covers what an assembled connector may reach).
# **Leave it empty unless you are deliberately connecting a service on your own network** — a
# CalDAV server, a mailer or an API you host yourself. Name its hostname here, nothing else:
# every host you add is a host an uploaded connector's spec can be pointed at.
CONNECTOR_EGRESS_ALLOW=
# How large an OpenAPI spec this instance accepts, in bytes. Empty = 2 MiB, which is
# enough for most vendor documents and not enough for some: GitHub publishes its REST
# description as a single 12 MB file. Raise it if you want to assemble a connector from
# a document like that (12582912 is 12 MiB); the parse happens in memory, so the number
# you put here is roughly the memory one upload can cost you.
CONNECTOR_SPEC_MAX_BYTES=

# Which skill catalogue the marketplace reads, as a GitHub repository API root
# (https://api.github.com/repos/<owner>/<repo>). Empty = the public anthropics/skills repo.
# Point it at your own repository to run your own catalogue; it is read without a token,
# so that repository has to be public. The layout it expects is skills/<id>/SKILL.md.
MARKETPLACE_GITHUB_BASE_URL=

# What the upgrade button on /admin/system POSTs.
#
# This instance has no control over its own host — the backend deliberately gets no
# docker.sock — so it cannot pull images or recreate containers. Whatever orchestrates it
# can. Paste that side's redeploy URL here (Coolify, Portainer, a CI webhook — the product
# does not care which, it POSTs the URL) and the upgrade button applies an upgrade.
#
# Leave it empty and the button says plainly that this instance cannot upgrade itself, and
# tells you what to run instead. Empty is a fine answer; a button that cannot do what it
# says is worse than no button.
STANDMEET_REDEPLOY_HOOK=

# Where "is there a newer version" is asked. Empty = the official images on ghcr.io.
# A fork that publishes its own images points these at itself.
STANDMEET_RELEASE_REGISTRY=
STANDMEET_RELEASE_REPO=
