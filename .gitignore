# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Secrets — never commit
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build outputs
dist/
dist-electron/
dist-renderer/
build/
out/
.next/
*.tsbuildinfo
# TikZ TeX faces (BaKoMa), copied out of node-tikzjax by app/scripts/copy-tikz-fonts.mjs on every
# build so they always match the installed package. 140 binaries — generated, never hand-edited.
app/public/tikz-fonts/

# embed bundle, copied out of sdk/packages/embed by app/scripts/copy-embed-bundle.mjs
# on every dev/build. 由本实例自己发（/embed.js），不入库 —— 产物跟着 sdk 源码走。
app/public/embed.js
# Go local-build binaries (when running `go build ./cmd/...` outside docker)
backend/standmeet
backend/server
backend/job-board-mock
backend/check-no-nil-container
infra/scripts/check-routes-via-dispatcher/check-routes-via-dispatcher
mock-stack/llm-gateway/llm-gateway

# Local QA scratch screenshots (manual snapshots at repo root)
/demo-*.png
/wiki-*.png

# Browser-driving aria snapshots dumped at repo root (Playwright/read_page output).
# These captured live connector credentials (a Google OAuth client secret + a bearer
# token) into tracked files and shipped them to the public repo — see the scrub in
# git history. Ignore every root-level .yml except the ones that are real config, so
# the next dump can never be `git add`-ed by accident. (Root only; subdir .yml unaffected.)
/*.yml
!/docker-compose*.yml
!/lefthook.yml

# Test outputs
test-results/
playwright-report/
coverage/
logs/
# Stray captured command output (docker build/up dumps that got committed by accident).
*.log

# Local DBs and data
*.sqlite
*.sqlite3
*.db

# IDE
.idea/
.vscode/
!.vscode/extensions.json
*.iml

# Tool caches
.turbo/
.cache/

# Playwright MCP screenshots (local QA scratch)
.playwright-mcp/

# sandboxed MCP plugin code (provisioned by infra/plugins/provision.sh, not committed)
infra/plugins/*/node_modules/
infra/plugins/*/pkg/
infra/plugins/ask-visitor/ask-visitor
infra/plugins/summarize/summarize
infra/plugins/booker/booker
infra/plugins/retrieval/retrieval
infra/plugins/mail-sender/mail-sender
render-*.png
e2e/test-results-archive/
# One directory per manual real-env verification round (run sheet + trajectories + shots).
# Evidence of a run, not a document about the product — only findings.md / ux.md rows are
# committed. See docs/real-env-verification/sop.md §0.
e2e/manual-runs/

# `go build ./...` in mock-stack drops host binaries next to their package. The images
# build their own; a committed host binary is churn that flips on every build.
mock-stack/job-board/job-board
mock-stack/mcp/mcp
mock-stack/llm-gateway/llm-gateway
mock-stack/mail/mail

# Screenshots dropped at the repo root. The browser tool writes a bare filename, so a
# screenshot taken during a manual audit lands here — and `git add -A` swept 106 of them
# into the repo across several rounds before anyone noticed. Root-anchored on purpose:
# real PNG assets living under app/, docs/ or sdk/ are unaffected. Audit shots belong in
# the round's trajectory dir (already ignored above); pass an absolute path when saving one.
/*.png

# builder/vendor —— SDK 产物的暂存地（infra/scripts/builder-vendor.sh 生成），不进仓库。
builder/vendor/
scratchpad-*.json
