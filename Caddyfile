# Caddyfile —— prod 反代。配 on-demand TLS：访客访问 unknown host 时
# Caddy 先 GET /internal/tls-ask?domain=<host> 确认是否合法 owner domain，
# 是再走 ACME 签证书。这样 self-host owner 只需 admin 加自己域名进
# allowed_domains 白名单，DNS A 记录指过来就自动 HTTPS。
#
# Cloudflare / 任意 reverse proxy 在更上层时把 X-Forwarded-* 透过来即可。
#
# 用法：
#   1. install.sh 自动把 PUBLIC_URL host 写进 instance_settings.allowed_domains
#   2. owner 在 admin UI 加 custom domain → add_allowed_domain
#   3. 访客解析 DNS → Caddy on-demand → ACME → HTTPS

{
	# on_demand TLS: Caddy 在请求第一次撞到 unknown host 时才申请证书。
	# ask URL 是 backend 暴露的白名单查询；非 200 → Caddy 拒签。
	# rate_limit 防滥发；burst 5 / interval 5m 是 Caddy 默认范围。
	on_demand_tls {
		ask http://backend:8000/internal/tls-ask
	}

	# admin API 关掉，prod 不应远程改 caddy 配置。
	admin off
}

# 默认 site block: 处理所有未明确列出的 host（dev / on-demand 时全部走这里）。
# tls 用 on_demand 让 Caddy 自动决定加密策略。
:443, :80 {
	tls {
		on_demand
	}

	# 把 owner upload 静态产物前置：custom-pages 走 app，app 内部再 rewrite
	# 到 backend；这样浏览器看 URL 始终是 https://<owner-domain>/<handle>/p/...
	reverse_proxy app:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}
