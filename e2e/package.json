{
  "name": "standmeet-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "StandMeet end-to-end tests — full-stack Playwright covering app + backend + sdk.",
  "scripts": {
    "lint": "eslint test/ fixtures/ && knip",
    "typecheck": "tsc --noEmit",
    "test": "bash script/run-e2e.sh",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.3",
    "fflate": "^0.8.3",
    "knip": "^6.0.5",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
