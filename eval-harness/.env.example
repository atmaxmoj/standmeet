# eval-harness self-reads this file (copy to .env, gitignored) so the stack
# carries its own LLM credentials instead of passing them on the command line.
# Process env overrides these; the deterministic mock-gateway modes ignore them.

# DeepSeek (OpenAI-compatible) — the default real-LLM target for interviews.
EVAL_PROVIDER=deepseek
EVAL_ENDPOINT=https://api.deepseek.com
EVAL_MODEL=deepseek-chat
EVAL_KEY=sk-your-deepseek-key-here
