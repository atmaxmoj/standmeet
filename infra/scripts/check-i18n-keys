#!/usr/bin/env python3
"""check-i18n-keys —— every t('key') call must resolve in its namespace's message file.

Why this exists: a missing message is not a build error. `useTranslations('adminCorpus.common')`
followed by `t('edit')` compiles, ships, and renders the KEY PATH to the owner —
`ADMINCORPUS.COMMON.EDIT` appeared on all 17 rows of /admin/subjectivity in the 2026-08-07 real-env
round, with 17 console errors nobody was watching. The repo's only i18n lint is
eslint-plugin-i18next, which asks the OPPOSITE question (is this string hardcoded?), and an e2e
that clicks the button passes too — the button is there, only its label is wrong.

So this walks the call sites instead: for each component, find `useTranslations('<ns>')` and every
`t('<key>')` that follows it, and assert `<ns>.<key>` exists in the message files.

    make i18n-keys        # or: infra/scripts/check-i18n-keys

Deliberately conservative: it only judges call sites it can read statically (a literal namespace
and a literal key). Dynamic keys are skipped and counted, so the report never claims coverage it
does not have.
"""

import json
import os
import re
import sys

ROOT = os.path.join(os.path.dirname(__file__), "..", "..")
SRC = os.path.join(ROOT, "app", "src")
MESSAGES_ROOT = os.path.join(SRC, "i18n", "messages")
# en is the base locale: the call sites are resolved against it, and every other locale must carry
# the exact same key set (a missing key falls back / renders the key path; an extra key is dead).
BASE_LOCALE = "en"
MESSAGES = os.path.join(MESSAGES_ROOT, BASE_LOCALE)

# Bind by VARIABLE NAME, not by proximity. A component routinely holds two of these —
#   const t  = useTranslations('adminIntegrations.connectorList');
#   const tc = useTranslations('adminIntegrations.common');
# — and a nearest-preceding-namespace rule attributes t('delete') to the wrong one. My first
# version did exactly that and reported a key as missing that resolves fine: one false alarm out
# of two reports. A gate that cries wolf half the time gets ignored, which is worse than no gate.
BIND = re.compile(r"""\bconst\s+(\w+)\s*=\s*useTranslations\(\s*['"]([\w.]+)['"]\s*\)""")
BIND_DYNAMIC = re.compile(r"""\bconst\s+(\w+)\s*=\s*useTranslations\((?!\s*['"])""")
# Catch both `t('k')` and `t.rich('k')`. The first version matched only `var(`, so every rich string
# (the ones with tags like <accent>) slipped under the gate — a gate blind to a whole class of calls
# is more dangerous than none, because it reports "all passing".
CALL = re.compile(r"""\b(\w+)(?:\.rich)?\(\s*['"]([\w.]+)['"]""")


def namespace_of(filename):
    """`admin-corpus.json` → `adminCorpus`. The FILE NAME is the namespace root; the file's own
    top-level keys are the level below it. Merging the files flat (my first version) invents
    missing keys for every namespace whose file does not repeat its own name — it reported 17
    false positives on pages I had just watched render correctly."""
    stem = filename[:-len(".json")]
    head, *rest = stem.split("-")
    return head + "".join(part.capitalize() for part in rest)


def load_locale(locale):
    """Every message in one locale, as `<namespace>.<dotted path inside the file>` (recursive)."""
    keys = set()

    def walk(prefix, node):
        if isinstance(node, dict):
            for k, v in node.items():
                walk(f"{prefix}.{k}", v)
        else:
            keys.add(prefix)

    locale_dir = os.path.join(MESSAGES_ROOT, locale)
    for name in sorted(os.listdir(locale_dir)):
        if not name.endswith(".json"):
            continue
        with open(os.path.join(locale_dir, name), encoding="utf-8") as fh:
            walk(namespace_of(name), json.load(fh))
    return keys


def load_messages():
    """The base (en) message key set — what the t() call sites resolve against."""
    return load_locale(BASE_LOCALE)


def other_locales():
    """Every locale dir under messages/ except the base (en)."""
    return sorted(
        name for name in os.listdir(MESSAGES_ROOT)
        if name != BASE_LOCALE and os.path.isdir(os.path.join(MESSAGES_ROOT, name))
    )


def check_locale_parity(base_keys):
    """Every non-base locale must carry EXACTLY the base's key set — recursively, across all
    namespaces. A key present in en but missing in zh renders the key path (or a stale fallback)
    to that language's users; a key present in zh but not en is dead weight that hides a rename.
    Returns [(locale, 'missing'|'extra', key)]; empty means every locale is at parity."""
    problems = []
    for locale in other_locales():
        locale_keys = load_locale(locale)
        for key in sorted(base_keys - locale_keys):
            problems.append((locale, "missing", key))
        for key in sorted(locale_keys - base_keys):
            problems.append((locale, "extra", key))
    return problems


def call_sites(path):
    """[(namespace, key, lineno)] for the statically readable calls in one file.

    Each translator variable carries its own namespace; a call is judged only when its callee
    name is one we bound to a literal namespace. Everything else (a computed namespace, a
    translator passed in as a prop, an ordinary function that happens to take a string) is
    skipped and counted — the report never claims coverage it does not have.

    Rebinding is normal: several components in one file each do `const t = useTranslations(...)`.
    A later binding wins for the lines after it, which is how the file reads top to bottom.
    """
    out, dynamic = [], 0
    bound = {}
    with open(path, encoding="utf-8") as fh:
        for lineno, line in enumerate(fh, 1):
            for var, ns in BIND.findall(line):
                bound[var] = ns
            for var in BIND_DYNAMIC.findall(line):
                bound.pop(var, None)  # computed namespace — stop judging this variable
            for var, key in CALL.findall(line):
                if var in bound:
                    out.append((bound[var], key, lineno))
                elif var in ("useTranslations",):
                    continue
                elif re.fullmatch(r"t[A-Za-z]*", var):
                    dynamic += 1  # looks like a translator but was never bound here
    return out, dynamic


def main():
    known = load_messages()
    missing, checked, skipped = [], 0, 0
    for dirpath, _dirs, files in os.walk(SRC):
        if "node_modules" in dirpath:
            continue
        for name in files:
            if not name.endswith((".tsx", ".ts")):
                continue
            path = os.path.join(dirpath, name)
            sites, dyn = call_sites(path)
            skipped += dyn
            for ns, key, lineno in sites:
                checked += 1
                if f"{ns}.{key}" not in known:
                    rel = os.path.relpath(path, ROOT)
                    missing.append(f"{rel}:{lineno}: {ns}.{key}")

    print(f"check-i18n-keys: {checked} t() call sites resolved against "
          f"{len(known)} messages ({skipped} dynamic keys skipped).")

    # Cross-locale recursive parity: every other locale must carry the exact en key set.
    parity = check_locale_parity(known)
    locales = other_locales()
    print(f"check-i18n-keys: {len(locales)} non-base locale(s) checked for key parity "
          f"against {BASE_LOCALE}: {', '.join(locales) or '(none)'}.")

    if missing or parity:
        if missing:
            print("\nMISSING t() keys — these render as the key path to the user:")
            for m in sorted(missing):
                print(f"  {m}")
        if parity:
            print("\nLOCALE KEY PARITY — every locale must mirror en exactly:")
            for locale, kind, key in parity:
                print(f"  {locale}: {kind} {key}")
        return 1
    print("every statically readable t() call resolves; every locale mirrors en.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
