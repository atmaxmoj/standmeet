#!/usr/bin/env bash
# check-no-mock —— G-Y enforces that backend/ contains no mock-only / test-only code.
#
# Five violation classes:
#   A) source patterns (MockProvider / INFERENCE_MOCK_ / /__mock / Test{Registry,
#      VisitorCap,GCalExpire})                          —— named blocklist
#   B) directories   (backend/cmd/job-board-mock, backend/cmd/mcp-server-mock)
#   C) files   (backend/internal/routes/sys/test_*.go)
#   D) fixture/canned named stand-ins (canned* / *Fixture / stub*) —— named blocklist
#   E) test-only package imports (testing / testify / httptest)  —— name-INDEPENDENT,
#      a structural signal; A/D's named blocklists can be dodged by a "neutral name,"
#      an import can't be.
#
# Excluded: _test.go (Go unit test files OK), lines starting with // (historical
# descriptions don't count as violations). Self-test lives in check-no-mock-test.sh
# (runs together with make backend-no-mock).
#
# Exit code: 0 = clean, 1 = violations found (lists every violation location).

set -euo pipefail

cd "$(dirname "$0")/../.."

backend_violations=0
report() {
  echo "❌ $1"
  backend_violations=$((backend_violations + 1))
}

# A) source patterns
patterns='MockProvider|INFERENCE_MOCK_|"/__mock/|TestRegistryDeps|TestVisitorCapabilitiesDeps|TestGCalExpireDeps'
src_hits=$(grep -rnE "$patterns" backend/ \
  --include='*.go' --exclude='*_test.go' 2>/dev/null \
  | grep -vE '^[^:]+:[0-9]+:[[:space:]]*//' \
  | grep -vE '^[^:]+:[0-9]+:[[:space:]]*\*' || true)
if [ -n "$src_hits" ]; then
  report "backend/ source contains a mock-only pattern (G-Y says it belongs in mock-stack/):"
  printf '%s\n' "$src_hits" | sed 's/^/  /'
fi

# B) directories
for dir in backend/cmd/job-board-mock backend/cmd/mcp-server-mock; do
  if [ -d "$dir" ]; then
    report "$dir/ — this whole binary belongs in mock-stack/ (G-Y)"
  fi
done

# C) files
test_files=$(find backend/internal/routes/sys -name 'test_*.go' 2>/dev/null || true)
if [ -n "$test_files" ]; then
  report "backend/internal/routes/sys/test_*.go should go through mock-stack admin or SQL/Redis instead:"
  printf '%s\n' "$test_files" | sed 's/^/  /'
fi

# D) fixture / canned test-double naming (P.13 invariant: zero fixtures in backend).
#    A canned implementation may only live in eval-harness's EvalDriver (the
#    ConcreteImplementor of the Bridge/Driver pattern); backend gets none, ever. This check
#    exists because backend/agentcore/*_fixture.go once welded cannedSandbox / skillFixture
#    into backend —— exactly the case this rule is meant to catch red (class A's named
#    blocklist missed it back then, and the fixture was deliberately "neutrally named" to
#    dodge it). Doesn't catch noop* —— that's a legitimate prod null-object (noopVerifier /
#    noopPDFRenderer), not a test double.
fixture_hits=$(grep -rnE 'canned[A-Z]|[a-zA-Z]Fixture\b|\bstub[A-Z]' backend/ \
  --include='*.go' --exclude='*_test.go' 2>/dev/null \
  | grep -vE '^[^:]+:[0-9]+:[[:space:]]*//' \
  | grep -vE '^[^:]+:[0-9]+:[[:space:]]*\*' || true)
if [ -n "$fixture_hits" ]; then
  report "backend/ contains a fixture/canned test double (P.13: canned belongs only in eval-harness's EvalDriver):"
  printf '%s\n' "$fixture_hits" | sed 's/^/  /'
fi

# E) test-only package import (name-INDEPENDENT): a non-_test.go backend file importing
#    testing / testify / httptest means a test double has leaked into prod. Classes A/D rely
#    on named blocklists, which a neutral name can dodge; an import is a structural signal
#    that can't be dodged — an otherwise "legitimate-looking" helper is exposed the moment it
#    uses one of these packages (guarded by check-no-mock-test.sh).
import_hits=$(grep -rnE '"testing"|"testing/[a-z]+"|"net/http/httptest"|github\.com/stretchr/testify' backend/ \
  --include='*.go' --exclude='*_test.go' 2>/dev/null \
  | grep -vE '^[^:]+:[0-9]+:[[:space:]]*//' \
  | grep -vE '^[^:]+:[0-9]+:[[:space:]]*\*' || true)
if [ -n "$import_hits" ]; then
  report "backend/ non-test file imports a test-only package (testing/testify/httptest → test double leaked into prod):"
  printf '%s\n' "$import_hits" | sed 's/^/  /'
fi

if [ "$backend_violations" -gt 0 ]; then
  echo
  echo "G-Y enforces: all mock infra lives in mock-stack/, backend/ keeps only the prod path."
  exit 1
fi

echo "✓ backend/ has no mock-only code"
