#!/usr/bin/env bash
# dev-stack —— one entry point for "which stack does this checkout drive, and run something on it".
#
# The per-checkout dev stack works by a `.dev-stack.env` naming a compose project and twelve
# host ports (see .dev-stack.env.example). What it did NOT have was a way to make one, and the
# example file said so in as many words: "There is no allocator: N worktrees means N people
# choosing N sets, and the only rule is that they differ."
#
# Choosing twelve non-colliding numbers by hand is the kind of task that is done carefully the
# first time and approximately the second. Getting it wrong does not fail loudly — the stack
# comes up, one service quietly binds a port another checkout was using, and the symptom lands
# on the OTHER person as a refused connection or a test failing on data that was true a second
# ago. So: an allocator, and a way to see what you are pointed at before you run anything.
#
#   dev-stack init [--force]   write .dev-stack.env with a free port block
#   dev-stack show             what this checkout drives, and who else holds those ports
#   dev-stack test SPEC        say which stack, then run that spec on it
#
# Everything here derives the identity the same way the Makefile and the e2e fixture do, so
# there is no fourth place that could disagree.

set -euo pipefail

cd "$(dirname "$0")/../.."
ENV_FILE=.dev-stack.env
# OWN_PROJECTS —— this checkout own compose projects; set by cmd_init before allocating.
OWN_PROJECTS=()
EXAMPLE=.dev-stack.env.example

# port_keys —— every port knob, in the order .dev-stack.env.example lists them. Read from the
# example file rather than restated, so a knob added there is allocated here without anyone
# remembering this script exists.
#
# BOTH stacks. A checkout runs a dev stack (the e2e suite) and a prod-posture stack (a
# verification round), and allocating only one of them is how the two ended up sharing six
# ports: prod's were literals in its compose file, so nothing that only knew the dev defaults
# could see them.
port_keys() { grep -oE '^(DEV|PROD)_PORT_[A-Z_]+' "$EXAMPLE"; }

# default_of KEY —— the value that was hardcoded before the per-checkout stack. Also read from
# the example file: two lists of defaults is one more than can be kept in agreement.
default_of() { grep -E "^$1=" "$EXAMPLE" | head -1 | cut -d= -f2; }

# free_port PORT —— nothing is listening on it. A bind test rather than a scan of `lsof`, so it
# answers the question the stack will actually ask when it comes up.
free_port() {
  python3 - "$1" <<'PY'
import socket, sys
s = socket.socket()
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
try:
    s.bind(("127.0.0.1", int(sys.argv[1])))
except OSError:
    sys.exit(1)
finally:
    s.close()
PY
}

# claimed_ports —— every port some OTHER checkout has already written down for itself.
#
# The third way two checkouts collide, and the one a bind test cannot see: a neighbour has
# allocated a block and its stack is simply not up right now. Its ports are free, and they are
# not anyone's default, so both existing checks pass — and the collision appears later, when
# both stacks happen to be running, as a port conflict nobody changed anything to cause.
#
# Enumerated with `git worktree list`, not by walking a directory: the checkouts are wherever
# the person put them, and a hardcoded `.claude/worktrees/*` would silently see none of them the
# day someone puts one elsewhere.
claimed_ports() {
  local here dir
  here=$(pwd -P)
  git worktree list --porcelain 2>/dev/null | while read -r kind dir; do
    [ "$kind" = "worktree" ] || continue
    [ "$dir" = "$here" ] && continue
    [ -f "$dir/.dev-stack.env" ] || continue
    grep -hoE '^(DEV|PROD)_PORT_[A-Z_]+=[0-9]+' "$dir/.dev-stack.env" | cut -d= -f2
  done
}

# mine PORT —— is this port published by one of THIS checkout's own stacks.
#
# Needed by the allocator, not just by `show`. A checkout reallocating (`init --force`) has its
# own stacks up, holding the very ports being replaced — and a bind test calls those taken. The
# allocator would then refuse every offset and demand a teardown before it would even compute a
# new one, which is a teardown to answer a question rather than to change anything.
mine() {
  local port=$1 p
  for p in "${OWN_PROJECTS[@]}"; do
    docker ps --filter "label=com.docker.compose.project=$p" --format '{{.Ports}}' 2>/dev/null \
      | grep -q ":$port->" && return 0
  done
  return 1
}

# holder PORT —— what is listening, as a name a person can act on. Best effort: `lsof` is not
# everywhere, and an unknown holder is still a holder.
#
# The `|| true` is load-bearing: lsof exits 1 when nothing is listening, and under `set -e` an
# assignment from a failing command substitution takes the script with it. The first version had
# it only in the caller's happy path, so `show` worked in the checkout where every port WAS held
# and printed an empty table in the one where none were — the case it exists for.
holder() {
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$1" -sTCP:LISTEN 2>/dev/null | awk 'NR==2 {print $1" (pid "$2")"}' || true
  fi
  return 0
}

# ── init ────────────────────────────────────────────────────────

# offset_ok OFFSET —— would every port shift by this amount land somewhere usable.
#
# Three ways it can fail, all checked, because each produces a different flavour of confusing:
#   * lands on another key's DEFAULT      → collides with the primary checkout the moment it starts
#   * lands on another key in THIS set    → two of our own services fight
#   * something is already listening      → collides with whatever is running now
#
# The first check spans BOTH stacks' defaults, which is the whole reason it is written as "any
# other key" rather than "any other dev key". A dev port that lands on prod's default does not
# collide with anything until someone opens a verification round, and then it takes down a stack
# that has the real corpus on it.
#
# On failure it prints WHY, to stderr. The first version returned a bare 1, so `pick_offset`
# could only report "no free block found" and blame the machine — while the actual reason was
# that the default set collides with itself at this stride. An operator reading that message
# went looking for a dozen running stacks that were not there.
offset_ok() {
  local offset=$1 key port
  local -a taken=()
  # Read once per offset, not per port: it shells out to git and to every neighbour's file.
  local claimed
  claimed=$(claimed_ports)
  for key in $(port_keys); do
    port=$(( $(default_of "$key") + offset ))
    [ "$port" -lt 65536 ] || { echo "+$offset: $key would be $port, past 65535" >&2; return 1; }
    for other in $(port_keys); do
      [ "$port" = "$(default_of "$other")" ] \
        && { echo "+$offset: $key lands on $port, which is $other's default" >&2; return 1; }
    done
    for t in ${taken[@]+"${taken[@]}"}; do
      [ "$port" = "$t" ] && { echo "+$offset: two of our own knobs want $port" >&2; return 1; }
    done
    # Written down by a neighbour, whether or not their stack is up right now.
    echo "$claimed" | grep -qx "$port" \
      && { echo "+$offset: $port is claimed by another checkout" >&2; return 1; }
    # A port this checkout's own stacks are publishing counts as available: it is being replaced.
    free_port "$port" || mine "$port" \
      || { echo "+$offset: something is listening on $port" >&2; return 1; }
    taken+=("$port")
  done
  return 0
}

# pick_offset —— the smallest offset that clears every check. A uniform offset keeps the file
# readable: someone reading `8000 → 8400` can see what happened, where eighteen unrelated numbers
# would have to be trusted.
#
# **The candidate list is not a straight 100..1500, and the reason is the third checkout.**
# Measured during a two-agent rehearsal, when the third one could not allocate at all:
#
#   * The DEFAULT SET COLLIDES WITH ITSELF at a stride of 100. `38127/38227`, `8000/8100` and
#     `9000/9100/9200/9300` are all defaults, so +100, +1000, +1100, +1200 and +1300 are dead on
#     an empty machine — five of the fifteen, before anything is running.
#   * EACH NEIGHBOUR POISONS ABOUT FOUR MORE. A checkout at +N owns 9000+N through 9300+N, so
#     every offset from N-200 to N+100 puts one of my knobs on one of theirs.
#
# Five structural plus two neighbours at four each is fifteen. Two checkouts exhausted the whole
# window, and the message blamed the machine — on a box with tens of thousands of free ports.
#
# So: the low band first, because +100 reads better than +2400 when nothing else is running, and
# then a wide band well clear of the crowded 8000-9500 region, where the same rehearsal measured
# every offset from +2200 to +6000 clean. Stepping by 500 up there keeps the list short; the
# blocks are 400 wide, so 500 never overlaps its neighbour.
pick_offset() {
  local offset
  for offset in $(seq 100 100 1500) $(seq 2000 500 20000); do
    if offset_ok "$offset" 2>/dev/null; then echo "$offset"; return 0; fi
  done
  echo "dev-stack: no free port block found (+100 to +20000)." >&2
  echo "  Why each of the first few was refused:" >&2
  for offset in $(seq 100 100 600); do offset_ok "$offset" >/dev/null 2>>/dev/stderr || true; done
  echo "  \`docker ps --format '{{.Names}} {{.Ports}}'\` shows what is running." >&2
  return 1
}

# project_name —— derived from the checkout directory, because that is the name the person
# already uses for this checkout. A worktree at .../worktrees/traffic-analytics becomes
# standmeet-wt-traffic-analytics, which is what `docker ps` will show them.
project_name() {
  printf 'standmeet-wt-%s' "$(basename "$PWD" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | sed 's/-*$//')"
}

cmd_init() {
  local force=${1:-}
  if [ -f "$ENV_FILE" ] && [ "$force" != "--force" ]; then
    echo "dev-stack: $ENV_FILE already exists — this checkout already has its stacks."
    echo "  \`make stack\` prints them. \`make stack-init FORCE=1\` reallocates."
    echo "  After reallocating, RECREATE what is running (\`make dev-up\` / \`make prod-up\`):"
    echo "  containers keep the ports they were started with, so until then the file describes"
    echo "  an intent and \`make stack\` will show every knob as held by something else."
    return 1
  fi
  local offset project
  # Whose ports may be reused: this checkout's current stacks, read from the file being
  # replaced. On a first init there is no file and the array is the names init is about to write,
  # which nothing is running under yet.
  identity
  OWN_PROJECTS=("$PROJECT" "$PROD")
  offset=$(pick_offset)
  project=$(project_name)
  {
    echo "# This checkout's own stacks — written by \`make stack-init\`, git-ignored."
    echo "# Every port is its default +$offset, and each was confirmed free when this was written."
    echo "# See .dev-stack.env.example for what each one is and why they must differ."
    echo "COMPOSE_PROJECT_NAME=$project"
    echo "PROD_PROJECT_NAME=$project-prod"
    for key in $(port_keys); do
      echo "$key=$(( $(default_of "$key") + offset ))"
    done
  } > "$ENV_FILE"
  echo "dev-stack: wrote $ENV_FILE — dev project $project, prod project $project-prod, at +$offset."
  echo "  Next: \`make dev-up\` for the e2e stack · \`make prod-up\` for the verification stack."
  cmd_show
}

# ── show ────────────────────────────────────────────────────────

# identity —— project and ports, resolved exactly as the Makefile resolves them: the file if
# there is one, the defaults otherwise.
identity() {
  if [ -f "$ENV_FILE" ]; then set -a; . "./$ENV_FILE"; set +a; fi
  PROJECT=${COMPOSE_PROJECT_NAME:-$(grep -E '^COMPOSE_PROJECT_NAME=' "$EXAMPLE" | cut -d= -f2)}
  # The prod project every prod recipe passes as `-p`. Same defaulting rule, so a checkout with
  # no file addresses exactly what it addressed before.
  PROD=${PROD_PROJECT_NAME:-$(grep -E '^PROD_PROJECT_NAME=' "$EXAMPLE" | cut -d= -f2)}
}

# containers_up PROJECT —— how many of that project's containers are running.
containers_up() {
  docker ps --filter "label=com.docker.compose.project=$1" --format '{{.Names}}' 2>/dev/null \
    | wc -l | tr -d ' ' || true
}

# ports_table PREFIX PROJECT —— one stack's knobs, and who is holding each port.
ports_table() {
  local prefix=$1 project=$2 key port who mine
  printf '  %-28s %-7s %s\n' 'KNOB' 'PORT' 'LISTENER'
  for key in $(port_keys | grep "^$prefix"); do
    eval "port=\${$key:-$(default_of "$key")}"
    who=$(holder "$port" || true)
    # A port held by the stack it belongs to is the healthy state; held by anything else is the
    # whole question this command exists to answer.
    mine=$(docker ps --filter "label=com.docker.compose.project=$project" --format '{{.Ports}}' 2>/dev/null | grep -c ":$port->" || true)
    if [ "${mine:-0}" -gt 0 ]; then who="this stack"
    elif [ -z "$who" ]; then who="—"
    else who="$who  ⚠ not this stack"
    fi
    printf '  %-28s %-7s %s\n' "$key" "$port" "$who"
  done
}

cmd_show() {
  identity
  if [ -f "$ENV_FILE" ]; then
    echo "from $ENV_FILE"
  else
    echo "no $ENV_FILE — this checkout uses the shared defaults."
    echo "Run \`make stack-init\` before running anything alongside another checkout."
  fi
  echo

  # Two stacks, listed apart. They are separate projects with separate data: the dev stack is
  # reset by every e2e spec, the prod stack holds the real corpus and a round never resets it.
  # Printing them as one table is how "which one am I about to wipe" stops being obvious.
  echo "DEV  (e2e suite)            project $PROJECT   ·  $(containers_up "$PROJECT") containers up"
  ports_table DEV_PORT "$PROJECT"
  echo "  db  $PROJECT-db-1"
  echo "  app http://localhost:${DEV_PORT_APP:-$(default_of DEV_PORT_APP)}   backend http://localhost:${DEV_PORT_BACKEND:-$(default_of DEV_PORT_BACKEND)}"
  echo
  echo "PROD (verification round)   project $PROD   ·  $(containers_up "$PROD") containers up"
  ports_table PROD_PORT "$PROD"
  echo "  db  $PROD-db-1"
  echo "  app http://localhost:${PROD_PORT_APP:-$(default_of PROD_PORT_APP)}   backend http://localhost:${PROD_PORT_BACKEND:-$(default_of PROD_PORT_BACKEND)}"
  echo "  VERIFY_BASE http://127.0.0.1:${PROD_PORT_APP:-$(default_of PROD_PORT_APP)}  (what make verify-shots dials)"
}

# ── test ────────────────────────────────────────────────────────

# cmd_test —— say which stack, then run the spec on it.
#
# The announcement is the point. A spec that reaches the wrong stack does not fail: it passes,
# against someone else's data. `password-reset.spec.ts` did exactly that for months — it issued
# a reset token from another checkout's backend and drove its own app with it, green throughout.
# Printing the target before the run is the cheapest place to notice.
cmd_test() {
  local spec=${1:-}
  [ -n "$spec" ] || { echo "usage: dev-stack test <spec-name> [REPEAT=n]" >&2; return 2; }
  shift
  identity
  echo "dev-stack: running '$spec' against $PROJECT (app :${DEV_PORT_APP:-$(default_of DEV_PORT_APP)}, backend :${DEV_PORT_BACKEND:-$(default_of DEV_PORT_BACKEND)})"
  echo
  make test-asis SPEC="$spec" "$@"
}

# ── ready ───────────────────────────────────────────────────────

# cmd_ready —— can this checkout open a verification round.
#
# A round is expensive to start and expensive to abandon: `make prod-up` builds, the instance
# has to be claimed, the vault has to be imported. Every prerequisite below has failed a round
# at least once by being discovered halfway through, where a missing credential looks like the
# product refusing to work. This says all of them at once, before anything is built.
#
# It reports; it does not create. Two of these are the owner's production secrets, and a script
# that copied them into N checkouts would be spreading them on its own initiative.
cmd_ready() {
  identity
  local bad=0
  say_ok()   { printf '  ✓ %s\n' "$1"; }
  say_miss() { printf '  ✗ %s\n     %s\n' "$1" "$2"; bad=1; }

  echo "verification prerequisites for this checkout:"

  [ -f "$ENV_FILE" ] \
    && say_ok "$ENV_FILE — own stacks ($PROJECT / $PROD)" \
    || say_miss "$ENV_FILE is missing" \
         "\`make stack-init\` — without it this checkout drives the SHARED default stacks."

  # The prod compose reads it, and it holds real secrets, so it is gitignored and per-checkout.
  [ -f .env ] \
    && say_ok ".env — prod stack secrets" \
    || say_miss ".env is missing (docker-compose.prod.yml reads it)" \
         "cp .env.example .env and fill it. Real secrets: the owner decides whether a checkout gets a copy."

  [ -f "$HOME/.config/standmeet/verify-creds.env" ] \
    && say_ok "~/.config/standmeet/verify-creds.env — owner login + real credentials" \
    || say_miss "~/.config/standmeet/verify-creds.env is missing" \
         "The driver reads the owner's login from it; without it every plan stops at the login form."

  [ -d "$HOME/Develop/writing/notes" ] \
    && say_ok "the real vault ($(find "$HOME/Develop/writing/notes" -name '*.md' 2>/dev/null | wc -l | tr -d ' ') notes)" \
    || say_miss "the real vault is not at ~/Develop/writing/notes" \
         "A round drives the real corpus. A seeded fixture corpus is a different product."

  # Ports last: they are the cheapest to fix and the only one this script can answer for itself.
  #
  # Only meaningful once this checkout HAS ports of its own. Without the file the values below
  # are the shared defaults, which belong to whoever is using them — and reporting those as
  # "free" told a checkout its ports were fine while it could not allocate any at all. Two
  # checks that disagree are worse than one check.
  if [ ! -f "$ENV_FILE" ]; then
    say_miss "no ports of its own yet" \
      "The numbers above are the shared defaults; \`make stack-init\` allocates a block."
  else
    local key port clash=0
    for key in $(port_keys | grep '^PROD_PORT'); do
      eval "port=\${$key:-$(default_of "$key")}"
      free_port "$port" || mine "$port" || clash=1
    done
    [ "$clash" = 0 ] \
      && say_ok "the prod ports are free or already this checkout's" \
      || say_miss "something else holds a prod port" "\`make stack\` names the holder."
  fi

  echo
  [ "$bad" = 0 ] \
    && echo "ready — \`make prod-up\` then \`make verify-round\`." \
    || { echo "not ready. Fix the ✗ lines above; a round started without them fails halfway, and"; \
         echo "a missing credential on a real surface reads as the product being broken."; return 1; }
}

case "${1:-show}" in
  init) shift; cmd_init "${1:-}" ;;
  show) cmd_show ;;
  ready) cmd_ready ;;
  test) shift; cmd_test "$@" ;;
  *) echo "usage: dev-stack {init [--force] | show | ready | test <spec>}" >&2; exit 2 ;;
esac
