#!/usr/bin/env python3
"""schema-drift —— report what a LIVE database is missing versus backend/db/schema.sql.

Why this exists: schema.sql is applied by postgres only on a FRESH volume. A long-lived
instance (prod, or a dev box nobody wiped) therefore keeps whatever schema it was born with,
and every column added since exists only in the file. Nothing tells you — the backend starts
fine and fails later, at the one query that needs the new column, on the one surface that uses
it. Before a verification round, ask the database what it actually has.

    make schema-drift                 # prod (default)
    STACK=dev make schema-drift       # the dev stack

It only DETECTS. Fixing is a hand-written, non-destructive ALTER (this is a greenfield repo
with no migration runner): read the definition out of schema.sql and add the column with its
default. Never re-apply schema.sql to a live volume — it drops nothing, but it is not idempotent
either, and a fresh-volume file is not a migration.
"""

import os
import re
import subprocess
import sys

CONTAINER = os.environ.get(
    "SCHEMA_DRIFT_CONTAINER",
    "standmeet-dev-db-1" if os.environ.get("STACK") == "dev" else "standmeet-prod-db-1",
)
SCHEMA = os.path.join(os.path.dirname(__file__), "..", "..", "backend", "db", "schema.sql")


def live_columns():
    """{table: {column}} as the running database reports it."""
    out = subprocess.run(
        ["docker", "exec", CONTAINER, "psql", "-U", "standmeet", "-d", "standmeet", "-At",
         "-c", "select table_name||'|'||column_name from information_schema.columns "
               "where table_schema='public'"],
        capture_output=True, text=True, check=True).stdout
    live = {}
    for line in out.splitlines():
        if "|" not in line:
            continue
        t, c = line.strip().split("|", 1)
        live.setdefault(t, set()).add(c)
    return live


def declared_columns():
    """{table: [column]} as schema.sql declares it.

    Column names are taken only from lines that START a definition at paren depth 1 — a
    multi-line CHECK (…) constraint would otherwise contribute its wrapped values as if they
    were columns, and the drift report would name things that are not columns at all.
    """
    sql = open(SCHEMA, encoding="utf-8").read()
    tables = {}
    for m in re.finditer(r"CREATE TABLE(?: IF NOT EXISTS)?\s+(\w+)\s*\((.*?)\n\);", sql, re.S):
        table, body, depth, cols = m.group(1), m.group(2), 0, []
        for raw in body.splitlines():
            line = raw.strip()
            starts_at_top = depth == 0
            depth += raw.count("(") - raw.count(")")
            if not starts_at_top or not line or line.startswith("--"):
                continue
            word = line.split()[0].lower()
            if word in ("primary", "foreign", "unique", "check", "constraint", "exclude"):
                continue
            cols.append(word)
        tables[table] = cols
    return tables


def main():
    live, declared = live_columns(), declared_columns()
    missing_tables = sorted(t for t in declared if t not in live)
    missing_cols = sorted(
        (t, c) for t, cols in declared.items() if t in live
        for c in cols if c not in live[t]
    )
    print(f"schema-drift: {CONTAINER} vs backend/db/schema.sql")
    if not missing_tables and not missing_cols:
        print("  in sync — every declared table and column exists in the live database.")
        return 0
    for t in missing_tables:
        print(f"  MISSING TABLE   {t}")
    for t, c in missing_cols:
        print(f"  MISSING COLUMN  {t}.{c}")
    print("\nApply them by hand, non-destructively — copy each definition out of "
          "backend/db/schema.sql (every added column carries a default or is nullable).")
    return 1


if __name__ == "__main__":
    sys.exit(main())
