{
  "name": "@standmeet/embed",
  "version": "0.0.0",
  "description": "StandMeet Web Components embed — single <script> drop-in for any site. Wraps @standmeet/sdk (React internally).",
  "type": "module",
  "license": "MIT",
  "private": false,
  "main": "./dist/esm/embed.js",
  "module": "./dist/esm/embed.js",
  "types": "./dist/esm/embed.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/embed.d.ts",
      "import": "./dist/esm/embed.js"
    },
    "./loader": "./dist/loader.global.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ && tsc --noEmit"
  },
  "devDependencies": {
    "@standmeet/sdk": "workspace:*",
    "@standmeet/sdk-core": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
