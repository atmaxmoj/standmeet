{
  "name": "@standmeet/eval-harness",
  "version": "0.0.0",
  "description": "Node CLI eval harness for StandMeet visitor agent: spawn the real @standmeet/agent-core VisitorAgent with fs / canned / direct-LLM adapters, run YAML scenarios, print transcripts (color stdout / JSONL / HTML). No backend / app / DB / docker spin-up.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "eval-harness": "./bin/eval-harness.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "scenarios",
    "fixtures",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ && tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@standmeet/agent-core": "workspace:*",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "eslint": "^9.39.3",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
